# 环境变量示例（复制为 .env 后填写；勿提交真实密钥）

LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# 按 Flow/Role 分工的快/慢模型；留空则两者都退回 LLM_MODEL（单模型部署零改动）
# LLM_FAST_MODEL=gemini-2.5-flash-lite
# LLM_REASONING_MODEL=gemini-2.5-pro
TOOL_BACKEND=mock

# --- CLI 身份（工号；未配则退回 local-dev）---
# WORK_AGENT_USER_ID=z00888363

# --- Postgres：生产和测试必须是两个不同的 database ---
# 新环境先建空库，再跑：python -m work_agent init-db
# 测试库：python -m work_agent init-db --test
POSTGRES_DSN=postgresql://work_agent:work_agent@localhost:5432/work_agent
POSTGRES_TEST_DSN=postgresql://work_agent:work_agent@localhost:5432/work_agent_test

# --- 公司 w3_search MCP（TOOL_BACKEND=real 时由 RealKnowledgeSearchTool 使用）---
# stdio 示例：
# W3_MCP_TRANSPORT=stdio
# W3_MCP_COMMAND=npx
# W3_MCP_ARGS=["-y","@company/w3-search-mcp"]
# 或 JSON 数组 / 空格分隔均可

# http 示例（内网 streamable HTTP）：
# W3_MCP_TRANSPORT=http
# W3_MCP_URL=http://w3-mcp.internal/mcp

# W3_MCP_TOOL_NAME=w3_search
# W3_MCP_QUERY_ARG=query
# W3_MCP_TOP_K_ARG=top_k
# W3_MCP_TIMEOUT=60

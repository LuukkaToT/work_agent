# 环境变量示例（复制为 .env 后填写；勿提交真实密钥）

LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# 按 Flow/Role 分工的快/慢模型；留空则两者都退回 LLM_MODEL（单模型部署零改动）
# LLM_FAST_MODEL=gemini-2.5-flash-lite
# LLM_REASONING_MODEL=gemini-2.5-pro
TOOL_BACKEND=mock

# --- CLI 身份（工号；未配则退回 local-dev）---
# WORK_AGENT_USER_ID=z00888363

# --- Postgres：生产和测试必须是两个不同的 database ---
# 新环境先建空库，再跑：python -m work_agent init-db
# 测试库：python -m work_agent init-db --test
POSTGRES_DSN=postgresql://work_agent:work_agent@localhost:5432/work_agent
POSTGRES_TEST_DSN=postgresql://work_agent:work_agent@localhost:5432/work_agent_test

# --- 公司 w3_search MCP（TOOL_BACKEND=real 时由 RealKnowledgeSearchTool 使用）---
# stdio 示例：
# W3_MCP_TRANSPORT=stdio
# W3_MCP_COMMAND=npx
# W3_MCP_ARGS=["-y","@company/w3-search-mcp"]
# 或 JSON 数组 / 空格分隔均可

# http 示例（内网 streamable HTTP）：
# W3_MCP_TRANSPORT=http
# W3_MCP_URL=http://w3-mcp.internal/mcp

# W3_MCP_TOOL_NAME=w3_search
# W3_MCP_QUERY_ARG=query
# W3_MCP_TOP_K_ARG=top_k
# W3_MCP_TIMEOUT=60

# --- 日志（API 默认 JSON stdout；CLI 可设 LOG_FORMAT=text）---
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# --- MCP Server（默认关闭；对 Agent Space 暴露 /mcp 时打开）---
# MCP_ENABLED=true
# MCP_SERVICE_TOKEN=
# MCP_ALLOWED_HOSTS=testing-agent.example.internal,testing-agent.example.internal:443
# 只有浏览器客户端才需要：
# MCP_ALLOWED_ORIGINS=https://agent-space.example.internal

# --- 公司流水线平台（TOOL_BACKEND=real 时由 RealPipelineTool 使用）---
# 鉴权：有静态 token 就用；否则用用户名密码走登录占位（pipeline_client.login_with_password）
# PIPELINE_API_BASE_URL=https://pipeline.internal/api
# PIPELINE_API_TOKEN=
# PIPELINE_API_USERNAME=
# PIPELINE_API_PASSWORD=
# PIPELINE_API_TIMEOUT=60
# 路径可用环境变量覆盖，不必改代码：
# PIPELINE_API_LOGIN_PATH=/auth/token
# PIPELINE_API_CREATE_PATH=/pipelines
# PIPELINE_API_START_PATH=/pipelines/{pipeline_id}/start
# PIPELINE_API_QUERY_PATH=/pipelines/{pipeline_id}
# 加载进 create 请求体的平台默认参数：
# PIPELINE_PROJECT_ID=
# PIPELINE_TENANT=
# PIPELINE_API_OPERATOR=
# PIPELINE_RESOURCE_POOL=default
# PIPELINE_RUNTIME_IMAGE=
# PIPELINE_CALLBACK_URL=
# PIPELINE_SITE=
# PIPELINE_RACK=

      "root_cause": "COMM 控制端点拒绝连接，服务未监听或端口配置错误",
      "expected_evidence_keys": [
        "E-COMM-1102",
        "Connection refused",
        "probable_component=comm"
      ],
      "user_input": "小区 load fail，判断是 COMM、RAT 还是 BBL 根因。",
      "pipeline": {
        "case_names": [
          "NR_BENCH_001_COMM_REFUSED"
        ],
        "version": "27B",
        "physical_env": "7.223.50.60"
      },
      "events": {
        "comm": [
          "112000|DEBUG|tcp_connect endpoint=10.10.7.21:19090 attempt=1 state=SYN_SENT",
          "112250|ERROR|COMM_LOAD_FAIL errorcode=E-COMM-1102 endpoint=10.10.7.21:19090 detail=Connection refused state=FAILED"
        ],
        "rat": [
          "113000|ERROR|RAT_LOAD_FAIL errorcode=E-RAT-1203 dependency=COMM dependency_state=FAILED cascade=true"
        ],
        "bbh": [
          "113500|WARN|radio_path_start skipped dependency=RAT_READY cascade=true"
        ],
        "bbl": [
          "114000|ERROR|CELL_SETUP_DEPENDENCY_FAILED cell=NR_CELL_0 errorcode=E-BBL-3104 probable_component=comm cascade=true"
        ],
        "compare": [
          "115000|INFO|verdict=NOT_RUN reason=CELL_NOT_READY"
        ]
      }
    },

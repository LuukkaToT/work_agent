      "expected_fail_kind": "case",
      "expected_root_component": "rat",
      "expected_evidence_keys": [
        "E-RAT-1211",
        "bandwidth_mhz=120",
        "allowed=[20,40,50,60,80,100]"
      ]
    },
    {
      "case_id": "b05_rat_worker_not_ready",
      "scenario": "bench05_rat_worker_not_ready",
      "user_input": "配置校验都通过但 RAT 一直不 ready，请分析环境资源。",
      "pipeline": {
        "case_names": [
          "NR_BENCH_005_RAT_WORKER_EXIT"
